ZERO_G_API_KEY=your_mainnet_api_key
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_MODEL=0gm-1.0-35b-a3b

# Hosting only: the exact HTTPS URL shown by your host, without a trailing path.
# PUBLIC_ORIGIN=https://manifest-hq.example.com
# BIND_HOST=0.0.0.0
# PORT=10000

# Optional: enables one Gemini attempt after a non-200 HTTP response from 0G.
# Documents/context go to Google; 0G private routing does not apply to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
